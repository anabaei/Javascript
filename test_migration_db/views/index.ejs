<h1> Hit Endpoint </h1>

<form action="/call" method="post">
    <label for="endpoint">Enter End Point: </label>
    <input id="endpoint" type="text" name="endpoint" value="" placeholder="url">
    <input id="token" type="text" name="token" value="" placeholder="token">
    <input type="submit" value="Submit">
</form>

 <% if (data != 0) { %>
 
   <table class="table table-striped" id="table">
    <thead>
       <tr class="alert-info">
          <th>Date</th>
          <th>Participations</th>
          <th>Views</th>
       </tr>   
    <thead>
    <tbody>
            <% data.forEach((item) => { %>
            
            <tr class="alert-info">
                <td><%= item.date %></td>
                <td><%= item.participations %></td>
                <td><%= item.views %></td>
            </tr>    
            <% }) %>

      </tbody>
   </table>         
 <% } %>