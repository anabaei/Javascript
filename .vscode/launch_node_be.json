{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [    
    {
      "type": "node",
      "request": "launch",
      "name": "Node",
      "runtimeExecutable": "yarn", 
      "runtimeArgs": [
        "start:noclient",  // to run yarn stat:noclient 
        "test-mocha:pure",
        "${file}"
      ],
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "localRoot": "${workspaceFolder}", // to run in current location
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
	]
}
